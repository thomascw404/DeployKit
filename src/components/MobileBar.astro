---
// Sticky call / book bar for phones. Hidden ≥ md. Body gets bottom padding so it never covers content.
import site from '../../site.config';
const bar = site.mobileBar!;
const { contact } = site;
const tel = bar.call && contact.phone ? `tel:${contact.phone.replace(/[^+\d]/g, '')}` : null;
---
<div class="mobile-bar fixed inset-x-0 bottom-0 z-40 grid gap-2 border-t border-line bg-bg/95 p-3 backdrop-blur md:hidden" style={`grid-template-columns:repeat(${[tel, bar.action].filter(Boolean).length},1fr);padding-bottom:max(.75rem, env(safe-area-inset-bottom))`}>
  {tel && (
    <a href={tel} class="btn-secondary !min-h-12 gap-2">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 3h3l2 5-2.5 1.5a11 11 0 0 0 7 7L16 14l5 2v3a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2z"/></svg>
      Call now
    </a>
  )}
  {bar.action && <a href={bar.action.href} class="btn-primary !min-h-12">{bar.action.label}</a>}
</div>

<style is:global>
  @media (max-width: 767px) { body:has(.mobile-bar) { padding-bottom: 5rem; } }
</style>
