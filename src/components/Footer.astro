---
import site from '../../site.config';
import Wordmark from './Wordmark.astro';
const { name, footer, nav, contact } = site;
const year = new Date().getFullYear();
---
<footer class="border-t border-line py-14">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 sm:px-6 md:grid-cols-[1.5fr_1fr_1fr] lg:px-8">
    <div>
      <a href="/" class="text-lg font-bold"><Wordmark /></a>
      <p class="mt-3 max-w-sm text-sm text-muted">{footer.blurb}</p>
    </div>
    <nav aria-label="Footer" class="flex flex-col gap-2 text-sm">
      {nav.map((n) => <a href={n.href} class="text-ink/80 hover:text-ink">{n.label}</a>)}
      <a href="#contact" class="text-ink/80 hover:text-ink">Contact</a>
    </nav>
    <div class="text-sm">
      <a href={`mailto:${contact.email}`} class="text-ink/80 hover:text-ink">{contact.email}</a>
      {contact.phone && <p class="mt-2 text-ink/80">{contact.phone}</p>}
    </div>
  </div>
  <p class="mx-auto mt-12 max-w-7xl px-5 font-mono text-xs text-muted sm:px-6 lg:px-8">© {year} {name}. {footer.legal ?? 'All rights reserved.'}</p>
</footer>
