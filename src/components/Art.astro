---
// Mock-UI card. Renders one ArtCard from site.config.ts. Purely decorative:
// callers wrap it in aria-hidden and provide a text description elsewhere.
import type { ArtCard } from '../config/types';

interface Props { card: ArtCard; class?: string; active?: boolean }
const { card, class: cls = '', active = false } = Astro.props;
const lines = card.lines ?? [];
const light = card.light ?? false;
---
<div
  class:list={[
    'art relative w-full rounded-2xl p-4 text-[13px] leading-snug shadow-2xl transition-all duration-500',
    light ? 'bg-white text-zinc-900 shadow-black/40' : 'glass text-ink shadow-black/50',
    cls,
  ]}
  data-active={active ? 'true' : 'false'}
  data-kind={card.kind}
>
  {card.tag && (
    <span class:list={['absolute -top-2.5 left-4 rounded-full px-2.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wider', 'bg-accent text-accent-ink']}>
      {card.tag}
    </span>
  )}

  {card.kind === 'search' && (
    <div class="space-y-2 pt-1">
      <div class:list={['flex items-center gap-2 rounded-full border px-3 py-1.5', light ? 'border-zinc-200' : 'border-line']}>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="opacity-50"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span>{card.title}</span><span class="h-3.5 w-px bg-current" style="animation: blink 1s step-end infinite"></span>
      </div>
      {lines.map((l, i) => (
        <div class:list={['rounded-lg px-3 py-2', i === 0 ? (light ? 'bg-zinc-50' : 'bg-ink/5') : '']}>
          <div class:list={[i === 0 ? 'font-semibold text-blue-600' : 'opacity-70', !light && i === 0 && 'text-sky-300']}>{l}</div>
        </div>
      ))}
    </div>
  )}

  {card.kind === 'steps' && (
    <ol class="space-y-2 pt-1">
      {lines.map((l, i) => (
        <li class="flex items-center gap-2.5">
          <span class="grid size-5 place-items-center rounded-full bg-accent text-[10px] font-bold text-accent-ink">{i + 1}</span>
          <span>{l}</span>
        </li>
      ))}
    </ol>
  )}

  {card.kind === 'pipeline' && (
    <div class="grid grid-cols-3 gap-2 pt-1">
      {(card.columns ?? []).map((c) => (
        <div class="rounded-lg bg-ink/5 p-2">
          <div class="mb-1.5 font-mono text-[10px] uppercase tracking-wider text-muted">{c.name}</div>
          {c.items.map((it) => <div class="mb-1 rounded-md bg-ink/10 px-2 py-1 text-[11px]">{it}</div>)}
        </div>
      ))}
    </div>
  )}

  {card.kind === 'form' && (
    <div class="space-y-2 pt-1">
      {card.title && <div class="text-[15px] font-bold">{card.title}</div>}
      {lines.map((l) => <div class:list={['rounded-md border px-3 py-2 opacity-70', light ? 'border-zinc-200' : 'border-line']}>{l}</div>)}
      {card.cta && <div class="rounded-md bg-accent px-3 py-2 text-center font-semibold text-accent-ink">{card.cta}</div>}
    </div>
  )}

  {card.kind === 'message' && (
    <div class="space-y-2 pt-1">
      {lines.map((l, i) => (
        <div class:list={['max-w-[85%] rounded-2xl px-3 py-2', i % 2 === 0 ? 'bg-ink/10' : 'ml-auto bg-accent text-accent-ink']}>{l}</div>
      ))}
      <div class="flex gap-1 pl-1">{[0, 1, 2].map((d) => <span class="size-1.5 rounded-full bg-current opacity-40" style={`animation: dots 1.2s ${d * 0.2}s infinite`}></span>)}</div>
    </div>
  )}

  {card.kind === 'metric' && (
    <div class="pt-1">
      <div class="text-muted">{card.title}</div>
      <div class="mt-1 flex items-baseline gap-2">
        <span class="text-4xl font-bold tracking-tight">{card.value}</span>
        {card.delta && <span class:list={['font-mono text-[11px]', light ? 'text-emerald-700' : 'text-emerald-400']}>{card.delta}</span>}
      </div>
    </div>
  )}

  {card.kind === 'browser' && (
    <div class="overflow-hidden rounded-lg">
      <div class:list={['flex items-center gap-1.5 px-2 py-1.5', light ? 'bg-zinc-100' : 'bg-ink/5']}>
        {[0, 1, 2].map(() => <span class="size-2 rounded-full bg-current opacity-20"></span>)}
        <span class="ml-2 truncate font-mono text-[10px] opacity-75">{card.title}</span>
      </div>
      <div class="space-y-2 p-3">
        {lines.map((l, i) => <div class:list={[i === 0 ? 'text-[17px] font-bold leading-tight' : 'opacity-60']}>{l}</div>)}
        {card.cta && <div class="inline-block rounded-full bg-accent px-3 py-1.5 font-semibold text-accent-ink">{card.cta}</div>}
      </div>
    </div>
  )}

  {card.kind === 'chart' && (
    <div class="pt-1">
      <div class="flex h-24 items-end gap-1.5">
        {(() => {
          const nums = lines.map(Number).filter((n) => !Number.isNaN(n));
          const max = Math.max(...nums, 1);
          return nums.map((n, i) => (
            <div class="flex-1 rounded-t bg-accent" style={`height:${(n / max) * 100}%;opacity:${0.35 + (i / nums.length) * 0.65}`}></div>
          ));
        })()}
      </div>
    </div>
  )}
</div>
