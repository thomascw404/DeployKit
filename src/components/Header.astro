---
import site from '../../site.config';
import Wordmark from './Wordmark.astro';
const { nav, headerCta, name, logo, contact, concept } = site;
const tel = contact.phone ? `tel:${contact.phone.replace(/[^+\d]/g, '')}` : null;
---
<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300" data-scrolled="false">
  {concept && (
    <div class="concept-bar flex h-9 items-center justify-center gap-2 bg-ink px-4 text-center text-[12px] font-medium text-bg">
      <span class="truncate">{concept.note}</span>
      {concept.href ? <a href={concept.href} class="shrink-0 underline underline-offset-2">{concept.by}</a> : <span class="shrink-0 font-semibold">{concept.by}</span>}
    </div>
  )}
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-5 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight">
      <Wordmark />
    </a>

    <nav aria-label="Primary" class="glass hidden rounded-full px-1.5 py-1.5 lg:flex">
      {nav.map((n) => <a href={n.href} class="rounded-full px-4 py-1.5 text-sm text-ink/80 transition hover:bg-ink/5 hover:text-ink">{n.label}</a>)}
    </nav>

    <div class="flex items-center gap-2">
      {tel
        ? <a href={tel} class="hidden items-center gap-2 px-3 text-sm font-semibold md:inline-flex"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 3h3l2 5-2.5 1.5a11 11 0 0 0 7 7L16 14l5 2v3a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2z"/></svg>{contact.phone}</a>
        : <a href={`mailto:${contact.email}`} class="hidden text-sm font-semibold xl:inline-flex xl:px-3">Email us</a>}
      <a href={headerCta.href} class="btn-primary hidden !min-h-10 !text-sm sm:inline-flex">{headerCta.label}</a>
      <button id="menu-btn" type="button" class="grid size-11 place-items-center rounded-full lg:hidden" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open navigation">
        <span class="relative block h-3.5 w-5">
          <span class="absolute left-0 top-0 h-px w-full bg-current transition"></span>
          <span class="absolute bottom-0 left-0 h-px w-full bg-current transition"></span>
        </span>
      </button>
    </div>
  </div>

  <div id="mobile-nav" hidden class="border-t border-line bg-bg/95 px-5 pb-7 pt-3 backdrop-blur lg:hidden">
    <nav aria-label="Mobile" class="flex flex-col">
      {nav.map((n) => <a href={n.href} class="border-b border-line py-3.5 text-lg font-semibold">{n.label}</a>)}
    </nav>
    <a href={headerCta.href} class="btn-primary mt-5 w-full">{headerCta.label}</a>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const btn = document.getElementById('menu-btn')!;
  const panel = document.getElementById('mobile-nav')!;
  const setOpen = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    panel.hidden = !open;
  };
  btn.addEventListener('click', () => setOpen(panel.hidden !== false));
  panel.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  const onScroll = () => header.dataset.scrolled = String(window.scrollY > 24);
  addEventListener('scroll', onScroll, { passive: true }); onScroll();
</script>

<style>
  #site-header[data-scrolled='true'] {
    background: color-mix(in oklab, var(--c-bg) 82%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-line);
  }
  #menu-btn[aria-expanded='true'] span span:first-child { top: 50%; transform: rotate(45deg); }
  #menu-btn[aria-expanded='true'] span span:last-child { bottom: auto; top: 50%; transform: rotate(-45deg); }
</style>
