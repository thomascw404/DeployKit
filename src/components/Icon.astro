---
import type { IconName } from '../config/types';
import { icons } from '../lib/icons';
interface Props { name: IconName; class?: string; size?: number }
const { name, class: cls = '', size = 24 } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[name]} />
