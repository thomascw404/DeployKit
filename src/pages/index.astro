---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Band from '../components/Band.astro';
import Process from '../components/Process.astro';
import Proof from '../components/Proof.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Offers from '../components/Offers.astro';
import Story from '../components/Story.astro';
import Location from '../components/Location.astro';
import MobileBar from '../components/MobileBar.astro';
import site from '../../site.config';

// Section registry: add a component here once, then order/toggle it from site.config.ts.
const registry = {
  hero: site.hero ? Hero : null,
  offers: site.offers ? Offers : null,
  story: site.story ? Story : null,
  location: site.location && site.business ? Location : null,
  services: site.services ? Services : null,
  band: site.band ? Band : null,
  process: site.process ? Process : null,
  proof: site.proof ? Proof : null,
  faq: site.faq ? Faq : null,
  contact: Contact,
} as const;
const sections = site.sections.map((id) => registry[id]).filter(Boolean);
---
<Base>
  <Header />
  <main id="main">
    {sections.map((S) => S && <S />)}
  </main>
  <Footer />
  {site.mobileBar && <MobileBar />}
</Base>
