{
  // Cloudflare Workers static-assets deploy (works on any account; URL = <name>.<account>.workers.dev).
  // Workers Builds: build `npm run build:fast`, deploy `npx wrangler deploy`. `npm run new` sets "name" to the site slug.
  // Form backend: see worker/index.ts header for the "main" + ASSETS binding to add.
  "name": "deploykit",
  "compatibility_date": "2026-11-12",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "workers_dev": true,
  "preview_urls": false
}
