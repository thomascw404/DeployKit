{
  "name": "deploykit",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Agent-ready framework for fast, accessible marketing sites and spec redesigns. Astro + Tailwind v4, deploys to Cloudflare Workers.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "build:fast": "astro build",
    "preview": "astro preview",
    "doctor": "node scripts/doctor.mjs",
    "new": "node scripts/new-site.mjs",
    "teardown": "node scripts/teardown.mjs",
    "qa": "node scripts/qa.mjs",
    "pitch": "node scripts/pitch.mjs",
    "single": "node scripts/single-file.mjs",
    "sync": "node scripts/sync-framework.mjs",
    "cf:protect": "node scripts/cf-protect.mjs",
    "skills:install": "node scripts/install-skills.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.10",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "axe-core": "^4.14.0",
    "playwright": "^1.65.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.161.0"
  },
  "engines": {
    "node": ">=22.23.0"
  }
